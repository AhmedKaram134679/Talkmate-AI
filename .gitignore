# ==============================================================================
# TalkMate AI - .gitignore
# After adding this file, untrack what was already committed:
#   git rm -r --cached --ignore-unmatch audit_*.txt final_*.txt analysis.txt \
#       *_REPORT.md *_SUMMARY.md before_restore_fix.sql
# ==============================================================================

# ------------------------------------------------------------------------------
# Flutter / Dart
# ------------------------------------------------------------------------------
.dart_tool/
.packages
.pub-cache/
.pub/
build/
**/build/
.flutter-plugins
.flutter-plugins-dependencies
.flutter-plugins-dependencies.*
coverage/
*.lcov
*.g.dart.bak
**/generated_plugin_registrant.*.bak
devtools_options.yaml
**/doc/api/

# ------------------------------------------------------------------------------
# Android / Gradle / Kotlin
# ------------------------------------------------------------------------------
android/.gradle/
android/.kotlin/
android/app/.cxx/
**/.cxx/
android/local.properties
android/captures/
android/gradle-wrapper.jar
android/app/debug/
android/app/profile/
android/app/release/
.gradle/
**/GeneratedPluginRegistrant.java
**/GeneratedPluginRegistrant.kt
*.apk
*.aab
*.ap_
*.dex
*.class
output-metadata.json
third_party/**/build/
third_party/**/.gradle/

# ------------------------------------------------------------------------------
# iOS / macOS / Linux / Windows native build output
# ------------------------------------------------------------------------------
ios/Pods/
ios/.symlinks/
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Flutter/ephemeral/
ios/Runner/GeneratedPluginRegistrant.*
macos/Pods/
macos/Flutter/ephemeral/
macos/Flutter/Flutter-Generated.xcconfig
macos/Flutter/flutter_export_environment.sh
**/xcuserdata/
**/*.xcuserstate
DerivedData/
linux/flutter/ephemeral/
windows/flutter/ephemeral/
windows/firebase_cpp_sdk/
firebase_cpp_sdk_*/
**/ephemeral/

# ------------------------------------------------------------------------------
# Native binaries and vendored example apps (re-downloaded or built on demand)
# ------------------------------------------------------------------------------
third_party/**/example/
*.pdb
*.exe
*.dll
*.dylib
*.so
*.lib
*.a
*.o
*.obj

# ------------------------------------------------------------------------------
# Signing keys, keystores and certificates  (NEVER commit)
# ------------------------------------------------------------------------------
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key
*.cer
*.crt
*.mobileprovision
*.p8
key.properties
**/key.properties
!key.properties.example
!**/key.properties.example
signing.properties
upload-keystore.*

# ------------------------------------------------------------------------------
# Secrets and credentials  (NEVER commit)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
secrets.json
**/secrets.json
firebase-service-account.json
**/service-account*.json
**/serviceAccount*.json
**/*-adminsdk-*.json
GoogleService-Info.plist
**/GoogleService-Info.plist
# google-services.json holds a client API key (not a secret), and Android builds
# need it, so it stays tracked. Restrict that key in Google Cloud by package name
# and SHA-1. To stop tracking it instead, uncomment the next line and run:
#   git rm --cached android/app/google-services.json
# android/app/google-services.json
.firebase/
firebase-debug.log*
firebase-debug.*.log
.runtimeconfig.json
supabase/.env
supabase/.env.*
supabase/.branches/
supabase/.temp/
supabase/functions/.env
supabase/functions/.env.*
.temp/
**/.temp/

# ------------------------------------------------------------------------------
# Node (functions/)
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.eslintcache

# ------------------------------------------------------------------------------
# Local databases, dumps and backups
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
*.dump
*.bak
*.backup
*.orig
*.rej
firebase.json.bak
before_restore_*.sql
**/dev-only/
supabase/seed.local.sql

# ------------------------------------------------------------------------------
# Archives and large artifacts
# ------------------------------------------------------------------------------
*.rar
*.zip
*.7z
*.tar
*.tar.gz
*.tgz
*.iso

# Keep flutter_webrtc binaries required by Windows CI
!third_party/flutter_webrtc/third_party/libwebrtc/
!third_party/flutter_webrtc/third_party/libwebrtc/**
!third_party/flutter_webrtc/third_party/downloads/
!third_party/flutter_webrtc/third_party/downloads/libwebrtc.zip

# ------------------------------------------------------------------------------
# Logs, audit dumps and AI/agent-generated reports (root level only)
# Keep README.md and the curated docs/ folder.
# ------------------------------------------------------------------------------
*.log
logs/
analysis*.txt
analyze_*.txt
analyzer_report*.txt
absolute_final_audit*.txt
production_audit*.txt
robocopy_log.txt
/audit_*.txt
/final_*.txt
/*_utf8.txt
/*_audit*.txt
/audit_complete.txt
/*_REPORT.md
/*_SUMMARY.md
/*_CHECKLIST.md
/*_GUIDE.md
/*_QUICK_REF*.md
/*_QUICK_START.md
/*_QUICK_REFERENCE.md
/*_INDEX.md
/*_VERIFICATION*.md
/*_IMPLEMENTATION*.md
/*_DOCUMENTATION*.md
/*_DELIVERY*.md
/*_WALKTHROUGH.md
/*_FIX.md
/*_ANALYSIS.md
/*_EVIDENCE.md
/*_MESSAGES*.md
/DEEP_LINK_*.md
/PKCE_*.md
/MEDIA_*.md
/STORAGE_SERVICE_*.md
/CRITICAL_BUG_*.md
/EXECUTION_CHECKLIST.md
/FINAL_EXECUTION_STATUS.md
/ROOT_CAUSE_*.md
/QUICK_REFERENCE.md
/PASSWORD_RESET_*.md
/SUPABASE_AUTH_*.md
/USER_FRIENDLY_*.md
!/README.md

# ------------------------------------------------------------------------------
# IDE / OS / editors
# ------------------------------------------------------------------------------
.idea/
.vscode/
*.iml
*.ipr
*.iws
.fleet/
.history/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

