rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------- Helper Functions ----------------
    function isSignedIn() { return request.auth != null && request.auth.uid != null; }
    function isChatParticipant(chatId) {
      return isSignedIn() && inArray(get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds, request.auth.uid);
    }

    // -------- webrtc_calls (WebRTC 1:1 signaling) --------
    match /webrtc_calls/{callId} {
      // Read: only participants (any of participantIds)
      allow read: if isSignedIn() && inArray(resource.data.participantIds, request.auth.uid);

      // Create: only caller may create; restrict fields and values
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'callerId','calleeId','participantIds','type','state',
          'offer','answer','createdAt','updatedAt','startedAt','endedAt'
        ])
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.calleeId is string
        && request.resource.data.calleeId != request.auth.uid
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && inArray(request.resource.data.participantIds, request.resource.data.callerId)
        && inArray(request.resource.data.participantIds, request.resource.data.calleeId)
        && request.resource.data.type in ['audio','video']
        && request.resource.data.state in ['initiated','ringing','connected','declined','ended','failed','disconnected']
        && isValidTimestamp(request.resource.data.createdAt);

      // Update: only participants; limit to signaling/state/timestamps
      allow update: if isSignedIn()
        && inArray(resource.data.participantIds, request.auth.uid)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'state','offer','answer','updatedAt','startedAt','endedAt'
        ])
        && (!('state' in request.resource.data)
            || request.resource.data.state in ['initiated','ringing','connected','declined','ended','failed','disconnected']);

      // Delete: never from client
      allow delete: if false;

      // ICE candidates subcollection
      match /candidates/{candId} {
        // Only participants can create/read their candidates
        allow create, read: if isSignedIn()
          && inArray(get(/databases/$(database)/documents/webrtc_calls/$(callId)).data.participantIds, request.auth.uid);
        // No updates/deletes from client
        allow update, delete: if false;
      }
    }

    // blocks: deterministic id "{blockerId}_{blockedId}"
    match /blocks/{blockId} {
      // Read: a user can read their own blocks (filter in client by blockerId == auth.uid)
      allow read: if isSignedIn();

      // Create: only blocker can create their own block doc
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['blockerId','blockedId','createdAt'])
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedId is string
        && request.resource.data.blockedId != request.auth.uid
        && isValidTimestamp(request.resource.data.createdAt);

      // Delete: only blocker can delete their block doc
      allow delete: if isSignedIn()
        && resource.data.blockerId == request.auth.uid;

      // No updates
      allow update: if false;
    }

    // Validate 'deletedFor' change: only current user's key may be set to true or removed
    function isValidDeletedForChange(oldMap, newMap) {
      let _old = oldMap == null ? {} : oldMap;
      let _new = newMap == null ? {} : newMap;
      return (
        _old.diff(_new).changedKeys().hasOnly([request.auth.uid]) &&
        _new.diff(_old).changedKeys().hasOnly([request.auth.uid]) &&
        (
          (_new[request.auth.uid] == true) ||
          !(request.auth.uid in _new)
        )
      );
    }

    function isGroupOwnerOrAdmin(chatId, uid) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId)).data;
      return (
        (chat.isGroup == true) && (
          (('groupOwnerId' in chat) && chat.groupOwnerId == uid) ||
          (('adminIds' in chat) && inArray(chat.adminIds, uid))
        )
      );
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function inArray(arr, val) {
      return arr != null && val in arr;
    }

    // Validate that only the current user's reaction changed on a reactions map
    function isValidReactionsChange(oldMap, newMap) {
      // Both maps can be null; normalize to maps
      let _old = oldMap == null ? {} : oldMap;
      let _new = newMap == null ? {} : newMap;

      // Only the current user's key may differ
      // Use diff on maps to ensure only one key (auth.uid) changed
      return (
        _old.diff(_new).changedKeys().hasOnly([request.auth.uid]) &&
        _new.diff(_old).changedKeys().hasOnly([request.auth.uid]) &&
        (
          // Either set/update to a string emoji
          (_new[request.auth.uid] is string) ||
          // Or removal (key not present)
          !(request.auth.uid in _new)
        )
      );
    }

    // Validate common timestamps
    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time + duration.value(1, 'm');
    }

    // ---------------- Users (read: signed-in, write: owner-only) ----------------
    match /users/{userId} {
      // Read: allow any signed-in user (required to resolve names/avatars)
      allow read: if isSignedIn();
      // Write: owner only
      allow write: if isUser(userId);

      // notifications sub-collection (owner only)
      match /notifications/{notifId} {
        allow read, write: if isUser(userId);
      }
    }

    // ---------------- Chats (participants only) ----------------
    match /chats/{chatId} {
      // Read: participants only
      allow read: if isChatParticipant(chatId);

      // Create a chat: requester must be a participant (keep existing field validations)
      allow create: if isSignedIn()
        && inArray(request.resource.data.participantIds, request.auth.uid)
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() >= 2
        && request.resource.data.participantIds.size() <= 256
        && request.resource.data.keys().hasOnly(['participantIds','isGroup','groupName','groupPhotoUrl','createdAt','updatedAt','lastMessageAt'])
        && (!('isGroup' in request.resource.data) || request.resource.data.isGroup is bool)
        && (!('groupName' in request.resource.data) || (request.resource.data.groupName is string && request.resource.data.groupName.size() <= 120))
        && (!('groupPhotoUrl' in request.resource.data) || request.resource.data.groupPhotoUrl is string)
        && (!('lastMessageAt' in request.resource.data) || isValidTimestamp(request.resource.data.lastMessageAt))
        && isValidTimestamp(request.resource.data.createdAt)
        && isValidTimestamp(request.resource.data.updatedAt);

      // Updates: participants only (keep existing safe field transitions)
      allow update: if isSignedIn()
        && inArray(resource.data.participantIds, request.auth.uid)
        && (
          // (A) metadata updates
          (
            request.resource.data.diff(resource.data).changedKeys().hasOnly(['lastMessageText','lastMessageSenderId','lastMessageAt','updatedAt','groupName','groupPhotoUrl'])
            && (!('groupName' in request.resource.data) || (request.resource.data.groupName is string && request.resource.data.groupName.size() <= 120))
            && (!('groupPhotoUrl' in request.resource.data) || request.resource.data.groupPhotoUrl is string)
            && (!('lastMessageText' in request.resource.data) || request.resource.data.lastMessageText is string)
            && (!('lastMessageSenderId' in request.resource.data) || request.resource.data.lastMessageSenderId is string)
            && (!('lastMessageAt' in request.resource.data) || isValidTimestamp(request.resource.data.lastMessageAt))
            && (!('updatedAt' in request.resource.data) || isValidTimestamp(request.resource.data.updatedAt))
          )
          ||
          // (B) allow participant to remove themselves only
          (
            request.resource.data.diff(resource.data).changedKeys().hasOnly(['participantIds','updatedAt'])
            && isValidTimestamp(request.resource.data.updatedAt)
            && inArray(resource.data.participantIds, request.auth.uid)
            && !(inArray(request.resource.data.participantIds, request.auth.uid))
            && request.resource.data.participantIds is list
            && request.resource.data.participantIds.size() == resource.data.participantIds.size() - 1
          )
        );

      // Delete: deny from client
      allow delete: if false;

      // messages sub-collection
      match /messages/{messageId} {
        allow read: if isSignedIn() && inArray(get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds, request.auth.uid);

        // Only participants can send, senderId must equal auth.uid, chatId must match, size constraints
        allow create: if isSignedIn()
          && inArray(get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds, request.auth.uid)
          && request.resource.data.keys().hasOnly(['chatId','senderId','type','text','mediaUrl','thumbnailUrl','mediaSize','status','createdAt'])
          && request.resource.data.chatId == chatId
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.type in ['text','image','audio','video','file','system']
          && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 4000))
          && (!('mediaUrl' in request.resource.data) || request.resource.data.mediaUrl is string)
          && (!('thumbnailUrl' in request.resource.data) || request.resource.data.thumbnailUrl is string)
          && (!('mediaSize' in request.resource.data) || (request.resource.data.mediaSize is int && request.resource.data.mediaSize <= 50 * 1024 * 1024))
          && request.resource.data.status in ['sent','delivered','read']
          && isValidTimestamp(request.resource.data.createdAt);

        // Allow updates for:
        //  - status: recipients (delivered/read) or sender (sent)
        //  - reactions: participant may set/remove their own emoji in reactions map
        //  - deletedFor: participant may mark message deleted for themselves only
        //  - deleted/deletedByName: global soft-delete by sender or group owner/admin
        //  - text/editedAt: sender may edit text within 15 minutes from creation (if not globally deleted)
        allow update: if isSignedIn()
          && inArray(get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds, request.auth.uid)
          && (
            (
              request.resource.data.diff(resource.data).changedKeys().hasOnly(['status']) &&
              request.resource.data.status in ['sent','delivered','read']
            ) || (
              // Reactions: only own key may change
              request.resource.data.diff(resource.data).changedKeys().hasOnly(['reactions']) &&
              isValidReactionsChange(resource.data.reactions, request.resource.data.reactions)
            ) || (
              // deletedFor: only current user can set/remove their own key
              request.resource.data.diff(resource.data).changedKeys().hasOnly(['deletedFor']) &&
              isValidDeletedForChange(resource.data.deletedFor, request.resource.data.deletedFor)
            ) || (
              // Global soft-delete: sender or group owner/admin
              request.resource.data.diff(resource.data).changedKeys().hasOnly(['deleted','deletedByName']) &&
              (resource.data.senderId == request.auth.uid || isGroupOwnerOrAdmin(chatId, request.auth.uid)) &&
              // deleted must be true if provided; deletedByName must be string if provided
              (!('deleted' in request.resource.data) || request.resource.data.deleted == true) &&
              (!('deletedByName' in request.resource.data) || request.resource.data.deletedByName is string)
            ) || (
              // Edit text within 15 minutes by sender, ensure editedAt is a server timestamp
              request.resource.data.diff(resource.data).changedKeys().hasOnly(['text','editedAt']) &&
              resource.data.senderId == request.auth.uid &&
              !(resource.data.deleted == true) &&
              request.time - resource.data.createdAt <= duration.value(15, 'm') &&
              (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 4000)) &&
              ('editedAt' in request.resource.data && request.resource.data.editedAt == request.time)
            )
          );

        // Allow delete by:
        //  - the original sender (DMs and groups)
        //  - OR in group chats: a group owner/admin (if fields exist on chat doc)
        allow delete: if isSignedIn()
          && inArray(get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds, request.auth.uid)
          && (
            resource.data.senderId == request.auth.uid ||
            (
              // Group management path
              (get(/databases/$(database)/documents/chats/$(chatId)).data.isGroup == true) &&
              (
                // Owner
                (
                  ('groupOwnerId' in get(/databases/$(database)/documents/chats/$(chatId)).data) &&
                  get(/databases/$(database)/documents/chats/$(chatId)).data.groupOwnerId == request.auth.uid
                ) ||
                // Admins array contains the user
                (
                  ('adminIds' in get(/databases/$(database)/documents/chats/$(chatId)).data) &&
                  inArray(get(/databases/$(database)/documents/chats/$(chatId)).data.adminIds, request.auth.uid)
                )
              )
            )
          );
      }

      // -------- typing indicators (subcollection, participants only) --------
      match /typing/{userId} {
        // Read: allow chat participants only
        allow read: if isChatParticipant(chatId);

        // Create: only the user can create their own typing indicator
        allow create: if isSignedIn() 
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['chatId','userId','startedAt','lastUpdatedAt'])
          && request.resource.data.chatId == chatId
          && request.resource.data.userId == request.auth.uid
          && isValidTimestamp(request.resource.data.startedAt);

        // Update: only the user can update their own typing indicator
        // Allow updating only 'lastUpdatedAt' without re-validating 'startedAt' freshness
        allow update: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['lastUpdatedAt'])
          && request.resource.data.chatId == chatId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.startedAt is timestamp
          && request.resource.data.lastUpdatedAt is timestamp;

        // Delete: only the user can delete their own typing indicator
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // -------- calls --------
    match /calls/{callId} {
      // Read: allow participants (callerId or calleeId)
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.callerId ||
        request.auth.uid == resource.data.calleeId
      );

      // Create: caller must be the authenticated user
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['callerId','calleeId','type','status','roomId','createdAt','startedAt','endedAt'])
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.calleeId is string
        && request.resource.data.calleeId != request.auth.uid
        && request.resource.data.type in ['audio','video']
        && request.resource.data.status in ['ringing','ongoing','ended','missed','rejected']
        && isValidTimestamp(request.resource.data.createdAt);

      // Update: only participants can update status
      allow update: if isSignedIn()
        && (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status','roomId','startedAt','endedAt','updatedAt'])
        && request.resource.data.status in ['ringing','ongoing','ended','missed','rejected'];

      allow delete: if false;
    }

    // -------- friendships & friend_requests --------
    // friend_requests: fromUserId sends to toUserId, status transitions controlled
    match /friend_requests/{reqId} {
      // Readable only by sender or receiver
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId
      );

      // Create by sender only, basic field validation
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['fromUserId','toUserId','status','createdAt','updatedAt'])
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toUserId is string
        && request.resource.data.toUserId != request.auth.uid
        && request.resource.data.status == 'pending'
        && isValidTimestamp(request.resource.data.createdAt)
        && isValidTimestamp(request.resource.data.updatedAt);

      // Update: only status changes by involved parties
      allow update: if isSignedIn()
        && (request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.toUserId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status','updatedAt'])
        && isValidTimestamp(request.resource.data.updatedAt)
        && (
          // Receiver can accept/decline when pending
          (request.auth.uid == resource.data.toUserId && resource.data.status == 'pending' && request.resource.data.status in ['accepted','declined']) ||
          // Sender can cancel when pending
          (request.auth.uid == resource.data.fromUserId && resource.data.status == 'pending' && request.resource.data.status == 'canceled')
        );

      // Prevent delete from client
      allow delete: if false;
    }

    // friendships: a normalized pair (userA, userB)
    match /friendships/{friendshipId} {
      // Only participants can read
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.userA || request.auth.uid == resource.data.userB
      );

      // Create: by either participant; restrict fields
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['userA','userB','createdAt'])
        && (request.auth.uid == request.resource.data.userA || request.auth.uid == request.resource.data.userB)
        && request.resource.data.userA is string
        && request.resource.data.userB is string
        && request.resource.data.userA != request.resource.data.userB
        && isValidTimestamp(request.resource.data.createdAt);

      // No updates from client
      allow update: if false;

      // Allow delete by either participant
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.userA || request.auth.uid == resource.data.userB
      );
    }
  }
  // ---------------- Public (open read, signed-in write) ----------------
  match /databases/{database}/documents/public/{docId} {
    allow read: if true;
    allow write: if request.auth != null;
  }

  // ---------------- Default deny-all catch-all ----------------
  match /databases/{database}/documents/{document=**} {
    allow read, write: if false;
  }
}
